# Handle line endings automatically for all files
* text=auto

# Force Unix line endings for these files
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
.gitignore text eol=lf
.env.example text eol=lf

# Windows specific
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries
*.pyc binary
*.so binary
*.egg binary
