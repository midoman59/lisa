# ============================================================
# Azure Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to GitHub (contains secrets)

# Subscription & Resource Group
AZURE_SUBSCRIPTION_ID=cd42c6a9-be39-499b-9cda-34d4cee517ab
AZURE_RESOURCE_GROUP=rg-uc25-assistant-lisa-creditme

# AI Foundry (Cognitive Services / LLM)
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_ENDPOINT=https://lisa-creditme.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini
# Option 1: Use Azure CLI login (recommended for dev)
# No API key needed - set AZURE_OPENAI_API_KEY="" or leave empty
# Option 2: Use API key (for production/automation)
AZURE_OPENAI_API_KEY=

# AI Search (RAG) - Optional for MVP
# AZURE_SEARCH_ENDPOINT=https://search-...search.windows.net/
# AZURE_SEARCH_INDEX_NAME=documents
# AZURE_SEARCH_KEY=

# Storage Account - Optional
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# PostgreSQL Database
DATABASE_HOST=bddlisacreditme.postgres.database.azure.com
DATABASE_PORT=5432
DATABASE_NAME=lisa_creditme_app
DATABASE_USER=adminlisacreditme
DATABASE_PASSWORD=
DATABASE_URL=postgresql://adminlisacreditme:[password]@bddlisacreditme.postgres.database.azure.com:5432/lisa_creditme_app

# ============================================================
# Application Settings
# ============================================================
DEBUG=True
LOG_LEVEL=INFO
